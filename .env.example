# Frame Extraction Worker - Environment Variables

# Path to the video file (required)
VIDEO_PATH=/path/to/your/video.mp4

# Unique identifier for this stream (default: default)
STREAM_ID=stream-001

# Redis connection address (default: localhost:6379)
REDIS_ADDR=localhost:6379

# Frame extraction rate in frames per second (default: 1)
# Use 0.0167 for 1 frame per minute
FRAME_RATE=1

# Redis key TTL in seconds (default: 2x frame interval, minimum 10s)
FRAME_TTL_SECONDS=120

# Path to ffmpeg binary (default: ffmpeg)
FFMPEG_PATH=ffmpeg
